generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Core multi-tenant tables
// ─────────────────────────────────────────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  companies     Company[]
  contacts      Contact[]
  conversations Conversation[]
  messages      Message[]
  webhookEvents WebhookEvent[]
  auditEvents   AuditEvent[]
  parties       Party[]
  listings      Listing[]
  requirements  Requirement[]
  matches       Match[]
  quotes        Quote[]

  @@map("organizations")
}

model User {
  id             String   @id @default(cuid())
  organizationId String
  email          String   @unique
  name           String
  role           UserRole @default(AGENT)
  passwordHash   String?  // null until the admin sets a password (dashboard login)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  auditEvents  AuditEvent[]

  @@index([organizationId])
  @@map("users")
}

enum UserRole {
  ADMIN
  AGENT
}

// ─────────────────────────────────────────────────────────────────────────────
// Business entities
// ─────────────────────────────────────────────────────────────────────────────

model Company {
  id             String      @id @default(cuid())
  organizationId String
  name           String
  type           CompanyType
  gst            String?     // GST registration number
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts     Contact[]

  @@index([organizationId])
  @@index([organizationId, type])
  @@map("companies")
}

enum CompanyType {
  TRADER
  RECYCLER
}

model Contact {
  id             String          @id @default(cuid())
  organizationId String
  companyId      String?
  waPhone        String          // WhatsApp phone number in E.164 format
  name           String?
  // Opt-in tracking
  optInSource    OptInSource
  optInAt        DateTime        @default(now())
  optInScope     String          // e.g. "transaction_updates,lot_alerts"
  optedOut       Boolean         @default(false)
  optedOutAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company       Company?       @relation(fields: [companyId], references: [id])
  conversations Conversation[]
  party         Party?

  @@unique([organizationId, waPhone])
  @@index([organizationId])
  @@map("contacts")
}

enum OptInSource {
  WEB_FORM
  QR_CODE
  AGENT_ADDED
  INBOUND_MESSAGE // contact messaged us first
}

// ─────────────────────────────────────────────────────────────────────────────
// Messaging
// ─────────────────────────────────────────────────────────────────────────────

model Conversation {
  id             String             @id @default(cuid())
  organizationId String
  contactId      String
  waPhone        String             // denormalised for fast lookup
  status         ConversationStatus @default(OPEN)
  // 24-hour service window: last inbound message timestamp
  lastInboundAt  DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact      Contact      @relation(fields: [contactId], references: [id])
  messages     Message[]

  @@unique([organizationId, contactId])
  @@index([organizationId])
  @@index([organizationId, status])
  @@map("conversations")
}

enum ConversationStatus {
  OPEN
  RESOLVED
  EXPIRED // 24-hour window closed
}

model Message {
  id             String          @id @default(cuid())
  organizationId String
  conversationId String
  // Provider tracking
  providerId     String?         @unique // WA message id (wamid); null until sent
  direction      MessageDirection
  // Content
  contentType    MessageContentType
  content        Json            // typed per contentType; see providers/types.ts
  // Status lifecycle
  status         MessageStatus   @default(PENDING)
  failureReason  String?
  retryCount     Int             @default(0)
  // Linked entity (lot, bid, etc.) — nullable until those modules are built
  linkedEntityType String?
  linkedEntityId   String?
  sentAt         DateTime?
  deliveredAt    DateTime?
  readAt         DateTime?
  failedAt       DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@index([organizationId])
  @@index([conversationId])
  @@index([providerId])
  @@map("messages")
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageContentType {
  TEXT
  TEMPLATE
  INTERACTIVE
  IMAGE
  DOCUMENT
  AUDIO
  VIDEO
  STICKER
  LOCATION
  CONTACTS
  REACTION
  UNKNOWN
}

enum MessageStatus {
  PENDING    // queued, not yet sent
  SENT       // accepted by provider
  DELIVERED  // delivered to device
  READ       // read by recipient
  FAILED     // terminal failure
  DEAD       // exceeded retries — dead-letter state
}

// ─────────────────────────────────────────────────────────────────────────────
// Webhook events — raw storage, idempotency key = providerEventId
// ─────────────────────────────────────────────────────────────────────────────

model WebhookEvent {
  id              String              @id @default(cuid())
  organizationId  String?             // may be unknown before processing
  providerEventId String              @unique // Meta: messaging[].id or status.id
  provider        String              @default("meta")
  rawPayload      Json
  processed       Boolean             @default(false)
  processedAt     DateTime?
  processingError String?
  createdAt       DateTime            @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([processed])
  @@map("webhook_events")
}

// ─────────────────────────────────────────────────────────────────────────────
// Marketplace bot
// ─────────────────────────────────────────────────────────────────────────────

model Party {
  id               String           @id @default(cuid())
  organizationId   String
  contactId        String           @unique  // one Party per Contact
  role             PartyRole?                // null until onboarding sets it
  name             String?
  city             String?
  company          String?
  onboardingStep   OnboardingStep   @default(ASK_ROLE)
  alertPreference  AlertPreference  @default(NONE)
  alertsOptedInAt  DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact      Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  listings     Listing[]
  requirements Requirement[]
  quotes       Quote[]

  @@index([organizationId])
  @@index([organizationId, role])
  @@map("parties")
}

enum PartyRole {
  BUYER
  SELLER
  BOTH
}

enum OnboardingStep {
  ASK_ROLE
  ASK_NAME
  ASK_CITY
  ASK_ALERTS
  DONE
}

enum AlertPreference {
  ALL
  MATCHING_ONLY
  NONE
}

// ─────────────────────────────────────────────────────────────────────────────
// Marketplace bot — listings & requirements
// ─────────────────────────────────────────────────────────────────────────────

model Listing {
  id             String        @id @default(cuid())
  organizationId String
  sellerPartyId  String
  code           String        // LST-0001, sequential per org
  product        String
  category       String?
  quantity       Decimal?      // nullable: DRAFT listings start with product only, filled in step by step
  unit           String?
  pricePerUnit   Decimal?
  currency       String        @default("INR")
  location       String?
  description    String?
  status         ListingStatus @default(DRAFT)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sellerParty  Party         @relation(fields: [sellerPartyId], references: [id], onDelete: Cascade)
  media        ListingMedia[]
  matches      Match[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([sellerPartyId])
  @@map("listings")
}

enum ListingStatus {
  DRAFT
  OPEN
  CLOSED
}

model ListingMedia {
  id              String   @id @default(cuid())
  listingId       String
  whatsappMediaId String
  storageUrl      String?
  mimeType        String?
  createdAt       DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@map("listing_media")
}

model Requirement {
  id             String            @id @default(cuid())
  organizationId String
  buyerPartyId   String
  product        String
  category       String?
  quantity       Decimal?
  unit           String?
  maxPrice       Decimal?          // buyer's budget
  location       String?
  deadlineDays   Int?              // "kitne din mein chahiye" — days from creation
  broadcastAt    DateTime?         // set once sellers in this location have been notified
  status         RequirementStatus @default(OPEN)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  buyerParty   Party             @relation(fields: [buyerPartyId], references: [id], onDelete: Cascade)
  matches      Match[]
  media        RequirementMedia[]
  quotes       Quote[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([buyerPartyId])
  @@map("requirements")
}

enum RequirementStatus {
  OPEN
  CLOSED
}

model RequirementMedia {
  id              String   @id @default(cuid())
  requirementId   String
  whatsappMediaId String
  storageUrl      String?
  mimeType        String?
  createdAt       DateTime @default(now())

  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@index([requirementId])
  @@map("requirement_media")
}

// ─────────────────────────────────────────────────────────────────────────────
// Seller quotes — a buyer's requirement is broadcast to local sellers, each
// seller's response (price, delivery time, quality, optional photos) is a Quote.
// ─────────────────────────────────────────────────────────────────────────────

model Quote {
  id             String      @id @default(cuid())
  organizationId String
  requirementId  String
  sellerPartyId  String
  price          Decimal?
  deliverByDays  Int?
  quality        String?
  status         QuoteStatus @default(PENDING)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requirement  Requirement  @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  sellerParty  Party        @relation(fields: [sellerPartyId], references: [id], onDelete: Cascade)
  media        QuoteMedia[]

  @@unique([requirementId, sellerPartyId])
  @@index([organizationId])
  @@index([requirementId])
  @@index([sellerPartyId])
  @@map("quotes")
}

enum QuoteStatus {
  PENDING
  SUBMITTED
}

model QuoteMedia {
  id              String   @id @default(cuid())
  quoteId         String
  whatsappMediaId String
  storageUrl      String?
  mimeType        String?
  createdAt       DateTime @default(now())

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@map("quote_media")
}

// ─────────────────────────────────────────────────────────────────────────────
// Matching — Phase 3
// ─────────────────────────────────────────────────────────────────────────────

model Match {
  id              String    @id @default(cuid())
  organizationId  String
  listingId       String
  requirementId   String
  notifiedSellerAt DateTime?
  notifiedBuyerAt  DateTime?
  buyerInterestedAt DateTime?
  createdAt       DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  listing      Listing      @relation(fields: [listingId], references: [id], onDelete: Cascade)
  requirement  Requirement  @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@unique([listingId, requirementId])
  @@index([organizationId])
  @@index([listingId])
  @@index([requirementId])
  @@map("matches")
}

// ─────────────────────────────────────────────────────────────────────────────
// Audit trail
// ─────────────────────────────────────────────────────────────────────────────

model AuditEvent {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?  // null for system actions
  action         String   // e.g. "message.sent", "contact.opted_out"
  entityType     String   // e.g. "Message", "Contact"
  entityId       String
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([organizationId, entityType, entityId])
  @@map("audit_events")
}
